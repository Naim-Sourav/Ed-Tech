# Copy this file to `.env.local` and fill in real values.
# ⚠️ NEVER commit real keys to git. `.env.local` is git-ignored.

# Gemini API key used by the AI Tutor / quiz generator.
# Get one free at https://aistudio.google.com/app/apikey
# (VITE_API_KEY is also accepted for backwards compatibility with CI.)
VITE_GEMINI_API_KEY=paste-your-key-here

# Backend API base URL (defaults to production when unset)
# VITE_API_BASE=https://mongodb-hb6b.onrender.com/api
