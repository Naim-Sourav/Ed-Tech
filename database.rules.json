{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "invites": {
      "$receiverUid": {
        ".read": "auth != null && auth.uid === $receiverUid",
        "$inviteId": {
          ".write": "auth != null"
        }
      }
    },

    "battles": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
